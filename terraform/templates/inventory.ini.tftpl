# Generated by Terraform (see terraform/inventory.tf) — do not edit by hand.
# Regenerate with: cd terraform && terraform apply

%{ for group, hosts in groups ~}
[${group}]
%{ for name, ip in hosts ~}
${name} ansible_host=${ip}
%{ endfor ~}

%{ endfor ~}
# Parent group, so vars below apply to every role.
[managed_nodes:children]
%{ for group in keys(groups) ~}
${group}
%{ endfor ~}

[managed_nodes:vars]
ansible_user=${ansible_user}
ansible_ssh_private_key_file=${ssh_private_key_file}
